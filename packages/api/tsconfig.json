{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",  // ⬅️ "./src"에서 "."로 변경
    "composite": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../shared/src/**/*.ts"  // ⬅️ shared 파일들도 포함
  ],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../shared" }
  ]
}